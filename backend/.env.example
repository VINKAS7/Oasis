# Generated by `npm run init-env` at the repo root.
# Fernet key that encrypts the AI provider API keys stored in the database.
# Changing it makes the saved keys unreadable (re-enter them in the admin panel).
SECRETS_KEY=
# Relative to backend/. Shared with the auth service.
DATABASE_PATH=../database/agentready.sqlite
AUTH_URL=http://127.0.0.1:3001
# Optional webhook-free contact string sent to Nominatim (OpenStreetMap geocoding).
GEOCODER_CONTACT=
# Automated tests only: run the recorder's browser without a window / expose it over CDP.
# RECORDER_HEADLESS=1
# RECORDER_CDP_PORT=9339
# Where AI assistants reach this server; shown to owners as their MCP address. To add Oasis to
# ChatGPT or Claude, set a public https address here (e.g. https://<name>.ngrok-free.app) and run
# `npm run dev:public`. Its host, chatgpt.com and claude.ai are then allowed automatically.
PUBLIC_API_URL=http://localhost:8000
# MCP gateway the customer chat page (/chat) talks to. Empty: this server's own, http://127.0.0.1:8000/mcp.
# CLIENT_MCP_URL=
# More Host and Origin values the MCP servers accept (DNS-rebinding protection).
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
