# Generated by `npm run init-env` at the repo root.
BETTER_AUTH_SECRET=
# Public URL the browser uses (the Vite dev server, or the backend in production).
BETTER_AUTH_URL=http://localhost:5173
AUTH_PORT=3001
# Relative to auth/. The Python API reads the same file.
DATABASE_PATH=../database/agentready.sqlite
# Comma-separated; these emails become admins when they sign up.
ADMIN_EMAILS=
# Extra comma-separated origins allowed to call the auth API.
TRUSTED_ORIGINS=
